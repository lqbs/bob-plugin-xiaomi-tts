{
    "identifier": "com.xiaomi.mimo.tts.bob.plugin",
    "version": "1.1.1",
    "category": "tts",
    "name": "小米 MiMo TTS",
    "summary": "为英语学习提供清晰稳定的语音朗读与本地缓存",
    "icon": "132",
    "author": "liqingbin",
    "homepage": "https://github.com/liqingbin/bob-plugin-xiaomi-tts",
    "appcast": "https://github.com/liqingbin/bob-plugin-xiaomi-tts/raw/main/appcast.json",
    "minBobVersion": "1.8.0",
    "options": [
        {
            "identifier": "apiKey",
            "type": "text",
            "title": "API Key",
            "desc": "小米开放平台 (https://platform.xiaomimimo.com) 中创建的 API Key",
            "textConfig": {
                "type": "secure",
                "placeholderText": "请输入 API Key",
                "height": "26"
            }
        },
        {
            "identifier": "voice",
            "type": "text",
            "title": "音色",
            "desc": "英文预置音色：Mia、Chloe、Milo、Dean",
            "defaultValue": "Dean",
            "textConfig": {
                "type": "visible",
                "placeholderText": "Dean",
                "height": "26"
            }
        },
        {
            "identifier": "stylePrompt",
            "type": "text",
            "title": "语气/风格指令",
            "desc": "控制语速、语气和发音；修改后会生成新的缓存",
            "defaultValue": "Read the English text clearly and accurately for an English learner. Use a neutral tone and a slightly slow, steady pace. Pronounce each word naturally, and read the supplied text exactly once without adding explanations or other words.",
            "textConfig": {
                "type": "visible",
                "placeholderText": "清晰、平稳地朗读英文",
                "height": "26"
            }
        },
        {
            "identifier": "timeout",
            "type": "text",
            "title": "超时时间（秒）",
            "desc": "请求超时时间，范围 10-120 秒",
            "defaultValue": "60",
            "textConfig": {
                "type": "visible",
                "placeholderText": "60",
                "height": "26"
            }
        }
    ]
}
