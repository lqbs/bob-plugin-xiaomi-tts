{
    "identifier": "com.xiaomi.mimo.tts.bob.plugin",
    "version": "1.0.0",
    "category": "tts",
    "name": "小米 MiMo TTS",
    "summary": "使用小米 MiMo 语音大模型 (MiMo-V2.5-TTS) 进行高质量语音合成",
    "icon": "132",
    "author": "liqingbin",
    "homepage": "https://github.com/liqingbin/bob-plugin-xiaomi-tts",
    "appcast": "https://github.com/liqingbin/bob-plugin-xiaomi-tts/raw/main/appcast.json",
    "minBobVersion": "1.8.0",
    "options": [
        {
            "identifier": "apiKey",
            "type": "text",
            "title": "API Key",
            "desc": "小米开放平台 (https://platform.xiaomimimo.com) 中创建的 API Key",
            "textConfig": {
                "type": "secure",
                "placeholderText": "请输入 API Key",
                "height": "26"
            }
        },
        {
            "identifier": "voice",
            "type": "text",
            "title": "音色",
            "desc": "填写音色名称，预置音色如：冰糖（默认）、茉莉、苏打、白桦、Mia 等",
            "defaultValue": "冰糖",
            "textConfig": {
                "type": "visible",
                "placeholderText": "冰糖",
                "height": "26"
            }
        },
        {
            "identifier": "audioFormat",
            "type": "menu",
            "title": "音频格式",
            "defaultValue": "mp3",
            "menuValues": [
                {
                    "title": "MP3（推荐）",
                    "value": "mp3"
                },
                {
                    "title": "WAV",
                    "value": "wav"
                },
                {
                    "title": "FLAC",
                    "value": "flac"
                },
                {
                    "title": "Opus",
                    "value": "opus"
                }
            ]
        },
        {
            "identifier": "stylePrompt",
            "type": "text",
            "title": "语气/风格指令",
            "desc": "设置朗读语气和风格，例如「用自然清晰的语调朗读」或「欢快的情绪」",
            "defaultValue": "用自然清晰的语调朗读",
            "textConfig": {
                "type": "visible",
                "placeholderText": "用自然清晰的语调朗读",
                "height": "26"
            }
        },
        {
            "identifier": "timeout",
            "type": "text",
            "title": "超时时间（秒）",
            "desc": "请求超时时间，范围 10-120 秒",
            "defaultValue": "60",
            "textConfig": {
                "type": "visible",
                "placeholderText": "60",
                "height": "26"
            }
        }
    ]
}
